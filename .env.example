# ==========================================================
#  WB / OZON STOCK SYNC v2.0 — LOCAL SECRETS
# ==========================================================

# ---------- Wildberries (Marketplace API v3) ----------
WB_API_TOKEN=
WB_BASE_URL=https://marketplace-api.wildberries.ru

# ---------- Ozon (Seller API) ----------
OZON_CLIENT_ID=123456
OZON_API_KEY=00000000-0000-0000-0000-000000000000
OZON_BASE_URL=https://api-seller.ozon.ru
# ID склада Ozon.
OZON_WAREHOUSE_ID=

# ---------- Маркетплейсы: вкл/выкл (тарификация) ----------
ENABLE_WB=true
ENABLE_OZON=true

# ---------- Данные ----------
CSV_PATH=stocks.csv
MAPPING_PATH=mapping.json

# ---------- Лимиты запросов и батчинг ----------
BATCH_SIZE=100

# Пауза между батчами внутри одного клиента (сек)
WB_REQUEST_DELAY=1.0
OZON_REQUEST_DELAY=0.8

# Экспоненциальный backoff (изолированный для каждого маркетплейса)
WB_BACKOFF_BASE=2.0
WB_BACKOFF_MAX=120.0
WB_MAX_RETRIES=5

OZON_BACKOFF_BASE=2.0
OZON_BACKOFF_MAX=120.0
OZON_MAX_RETRIES=5

# ---------- Сеть и планировщик ----------
REQUEST_TIMEOUT=30
SYNC_INTERVAL_MINUTES=15
RUN_ON_STARTUP=true

# ---------- Логирование ----------
LOG_LEVEL=INFO
LOG_FILE=sync.log